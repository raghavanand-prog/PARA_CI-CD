{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/health", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "env": {
    "NODE_ENV": "production",
    "JWT_ISSUER": "secure-aws-cicd-demo-api-vercel",
    "JWT_EXPIRES_IN": "1h",
    "BCRYPT_SALT_ROUNDS": "12",
    "RATE_LIMIT_WINDOW_MS": "900000",
    "RATE_LIMIT_MAX": "100",
    "LOG_LEVEL": "info"
  }
}
