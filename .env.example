# Copy to .env for local development. Never commit the real .env file
# (already covered by .gitignore). No value below is a real secret.

NODE_ENV=development
PORT=3000
AWS_REGION=us-east-1

# In production this is injected by ECS from Secrets Manager (see
# terraform/modules/security + terraform/modules/ecs) — it is never set to
# a real value here or anywhere else in source control.
JWT_SECRET=replace-with-a-long-random-string-for-local-dev-only
JWT_EXPIRES_IN=1h
JWT_ISSUER=secure-aws-cicd-demo-api

# Opaque, server-tracked refresh token lifetime (see
# app/src/models/refreshTokenStore.js) — separate from the access token
# above, and long-lived by design since it's revocable, unlike the JWT.
REFRESH_TOKEN_EXPIRES_IN_MS=604800000

BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

LOG_LEVEL=info
